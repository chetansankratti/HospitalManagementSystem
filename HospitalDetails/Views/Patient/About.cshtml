@model PatientModel

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
    <link rel="stylesheet" href="~/css/Style.css"/>
}
<div class="about-content">
    <h2>Manipal Hospital's</h2>

    <p class="about-p">Manipal Hospitals is a multi-specialty healthcare provider in India that offers a range of services, including diagnostics, outpatient treatment, and critical care. Manipal Hospitals has multiple locations in Bangalore, including Old Airport Road and Malleshwaram.</p>
    <h3 class="about-h3">Features</h3>

    <h4 class="about-h4">Services</h4>
    <p class="about-p">Offers a range of services, including diagnostics, outpatient treatment, and critical care.</p>

    <h4 class="about-h4">Facilities</h4>
    <p class="about-p">Equipped with state-of-the-art facilities and the latest technologies.</p>

    <h4 class="about-h4">Patient care</h4>
    <p class="about-p">Has an international patient care team that helps patients with travel and accommodation arrangements.</p>

    <h4 class="about-h4">Staff</h4>
    <p class="about-p">Staff is dedicated to making patients feel at ease during their medical treatment.</p>

    <h4 class="about-h4">Locations</h4>
    <p class="about-p">Manipal Hospitals, Old Airport Road: One of the top multi-specialty hospitals in Bangalore.</p>
    <p class="about-p">Manipal Hospitals, Malleshwaram: An 83-bed hospital that caters to the residents in & around Malleshwaram ,Whitefield,Maratahalli,Eelectronic City,Jayanagr.</p>
   

    <h4 class="about-h4">Other information</h4>
    <p class="about-p">Manipal Hospitals is part of the Manipal Education and Medical Group (MEMG).</p>
    <p class="about-p">The shades of blue used in the Manipal Hospitals logo signify values of trust and dedication that are at the core of the healthcare network.</p>
    <p class="about-p"> Telephone Number : 000 880 666 123 / 000 848 555 490 </p><br/>

    <button class="btn btn-outline-success"><a href="@Url.Action("Home","Patient")">Back</a></button>
</div>